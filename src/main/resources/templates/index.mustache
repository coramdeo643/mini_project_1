{{> layout/header}}

<div class="container p-5">

    {{^isCompanyUser}}
        <div class="dropdown-center mb-3">
            <button class="btn btn-sm btn btn-outline-success dropdown-toggle" type="button" data-bs-toggle="dropdown"
                    aria-expanded="false">
                기술스택
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="/">전체</a></li>
                <li><a class="dropdown-item" href="/board/filter?skill=Java">Java</a></li>
                <li><a class="dropdown-item" href="/board/filter?skill=Spring Boot">Spring Boot</a></li>
                <li><a class="dropdown-item" href="/board/filter?skill=MySQL">MySQL</a></li>
                <li><a class="dropdown-item" href="/board/filter?skill=JavaScript">JavaScript</a></li>
                <li><a class="dropdown-item" href="/board/filter?skill=Linux">Linux</a></li>
                <li><a class="dropdown-item" href="/board/filter?skill=React">React</a></li>
                <li><a class="dropdown-item" href="/board/filter?skill=Vue.js">Vue.js</a></li>
                <li><a class="dropdown-item" href="/board/filter?skill=Node.js">Node.js</a></li>
                <li><a class="dropdown-item" href="/board/filter?skill=Python">Python</a></li>
                <li><a class="dropdown-item" href="/board/filter?skill=Docker">Docker</a></li>
            </ul>
        </div>

        <div class="row">
            {{#boardPage.content}}
                <div class="col-md-4 mb-4" style="padding-left: 0.5rem; padding-right: 0.5rem;">
                    <a href="/board/{{id}}" class="btn" style="display: block; width: 100%; text-decoration: none;">
                        <div class="card p-3 text-center" style="width: 100%;">
                            <div style="height: 100px; display: flex; justify-content: center; align-items: center;">
                                <img src="{{company.imageUrl}}" alt="회사 이미지"
                                     style="width: 150px; height: 100px; object-fit: contain; background-color: #fff;">
                            </div>
                            <div class="card-body">
                                <h5 class="card-title">{{title}}</h5>
                                <p class="card-text">기업명 : {{company.businessName}}&nbsp;|&nbsp;{{time}}</p>
                                <div class="mb-3">
                                    {{#boardSkills}}
                                        <span class="badge text-primary-emphasis bg-primary-subtle border border-primary-subtle rounded-3 me-1">
                                            {{skill.name}}
                                        </span>
                                    {{/boardSkills}}
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            {{/boardPage.content}}
        </div>
    {{/isCompanyUser}}

    {{#isCompanyUser}}
        <div class="dropdown-center mb-3">
            <button class="btn btn-sm btn btn-outline-success dropdown-toggle" type="button" data-bs-toggle="dropdown"
                    aria-expanded="false">
                기술스택
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="/">전체</a></li>
                <li><a class="dropdown-item" href="/ppost/filter?skill=Java">Java</a></li>
                <li><a class="dropdown-item" href="/ppost/filter?skill=Spring Boot">Spring Boot</a></li>
                <li><a class="dropdown-item" href="/ppost/filter?skill=MySQL">MySQL</a></li>
                <li><a class="dropdown-item" href="/ppost/filter?skill=JavaScript">JavaScript</a></li>
                <li><a class="dropdown-item" href="/ppost/filter?skill=Linux">Linux</a></li>
                <li><a class="dropdown-item" href="/ppost/filter?skill=React">React</a></li>
                <li><a class="dropdown-item" href="/ppost/filter?skill=Vue.js">Vue.js</a></li>
                <li><a class="dropdown-item" href="/ppost/filter?skill=Node.js">Node.js</a></li>
                <li><a class="dropdown-item" href="/ppost/filter?skill=Python">Python</a></li>
                <li><a class="dropdown-item" href="/ppost/filter?skill=Docker">Docker</a></li>
            </ul>
        </div>

        <div class="row">
            {{#ppostPage.content}}
                <div class="col-md-4 mb-4" style="padding-left: 0.5rem; padding-right: 0.5rem;">
                    <a href="/board/{{id}}" class="btn" style="display: block; width: 100%; text-decoration: none;">
                        <div class="card p-3 text-center" style="width: 100%;">
                            <div style="height: 100px; display: flex; justify-content: center; align-items: center; ">
                                <img src="/images/USER.jpg" alt="이력서 이미지"
                                     style="width: 100px; height: 100px; object-fit: cover; border-radius: 50%; background-color: #fff;">
                            </div>
                            <div class="card-body">
                                <h5 class="card-title">{{title}}</h5>
                                <p class="card-text">작성자 : {{user.personalName}}&nbsp|&nbsp{{time}}</p>
                                <div class="mb-3">
                                    {{#pPostSkills}}
                                        <span class="badge text-primary-emphasis bg-primary-subtle border border-primary-subtle rounded-3 me-1">
                                            {{skill.name}}
                                        </span>
                                    {{/pPostSkills}}
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            {{/ppostPage.content}}
        </div>
    {{/isCompanyUser}}


    <ul class="pagination d-flex justify-content-center">
        <!--   이번 페이지 버튼      -->
        {{#previousPageNumber}}
            <li class="page-item">
                <a class="page-link" href="/?page={{previousPageNumber}}&size={{size}}">Previous</a>
            </li>
        {{/previousPageNumber}}
        {{^previousPageNumber}}
            <li class="page-item disabled">
                <a class="page-link" href="#">Previous</a>
            </li>
        {{/previousPageNumber}}

        <!-- 페이지 번호 -->
        {{#pageLinks}}
            <li class="page-item {{#active}}active{{/active}}">
                <a class="page-link" href="/?page={{displayNumber}}&size={{size}}">{{displayNumber}}</a>
            </li>
        {{/pageLinks}}

        <!-- 다음 페이지 버튼  -->
        {{#nextPageNumber}}
            <li class="page-item">
                <a class="page-link" href="/?page={{nextPageNumber}}&size={{size}}">Next</a>
            </li>
        {{/nextPageNumber}}
        {{^nextPageNumber}}
            <li class="page-item disabled">
                <a class="page-link" href="#">Next</a>
            </li>
        {{/nextPageNumber}}
    </ul>

</div>

{{> layout/footer}}