{{> layout/header}}

<div class="container p-5">

{{^isCompanyUser}}
    {{#boardList}}
        <div class="card mb-3">
            <div class="card-body">
                <!-- {{! title}} 은 현재 Board 객체읭 title 멤버 변수에 값을 출력한다.
                        머스태치는 자동으로 getTitle()메서드를 호출한 것이다.-->
                <h4 class="card-title mb-3">{{title}}</h4>
                <p> 기업명 : {{company.businessName}}&nbsp|&nbsp{{time}}</p>
                <a href="/board/{{id}}" class="btn btn-primary">상세보기</a>
            </div>
        </div>
    {{/boardList}}
{{/isCompanyUser}}

    {{#isCompanyUser}}
        {{#ppostList}}
            <div class="card mb-3">
                <div class="card-body">
                    <!-- {{! title}} 은 현재 Board 객체읭 title 멤버 변수에 값을 출력한다.
                        머스태치는 자동으로 getTitle()메서드를 호출한 것이다.-->
                    <h4 class="card-title mb-3">{{title}}</h4>
                    <p> 작성자 : {{user.username}}&nbsp|&nbsp{{time}}</p>
                    <a href="/ppost/{{id}}" class="btn btn-primary">상세보기</a>
                </div>
            </div>
        {{/ppostList}}
    {{/isCompanyUser}}


    <ul class="pagination d-flex justify-content-center">
        <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
        <li class="page-item"><a class="page-link" href="#">Next</a></li>
    </ul>

</div>

{{> layout/footer}}