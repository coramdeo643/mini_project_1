{{> layout/header}}

<div class="container p-5">
    <!-- 상단 버튼 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📋 내 채용공고 목록</h2>
        <a href="/board/save-form" class="btn btn-primary">✏️ 공고 등록</a>
    </div>

    <!-- 공고 리스트 -->
    <div class="row">
        {{#companyBoardList}}
            <div class="col-md-4 mb-4" style="padding-left: 0.5rem; padding-right: 0.5rem;">
                <div class="card p-3 text-center" style="width: 100%;">
                    <div style="height: 100px; display: flex; justify-content: center; align-items: center;">
                        <img src="{{company.imageUrl}}" alt="회사 이미지"
                             style="width: 150px; height: 100px; object-fit: contain; background-color: #fff;">
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">{{title}}</h5>
                        <p class="card-text">기업명 : {{company.businessName}}&nbsp;|&nbsp;{{time}}</p>
                        <div class="mb-3">
                            {{#boardSkills}}
                                <span class="badge text-primary-emphasis bg-primary-subtle border border-primary-subtle rounded-3 me-1">
                                    {{skill.name}}
                                </span>
                            {{/boardSkills}}
                        </div>

                        <div class="d-flex justify-content-center gap-2 mt-2">
                            <a href="/board/{{id}}" class="btn btn-sm btn-outline-primary">상세보기</a>
                            <a href="/board/{{id}}/update-form" class="btn btn-sm btn-outline-secondary">수정</a>
                            <form action="/board/{{id}}/delete" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('정말 삭제하시겠습니까?')">삭제
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        {{/companyBoardList}}
    </div>

    <!-- 공고가 없는 경우 -->
    {{^companyBoardList}}
        <div class="text-center text-muted mt-5">
            <p>등록된 채용공고가 없습니다.</p>
            <a href="/board/save-form" class="btn btn-outline-primary">+ 첫 공고 등록하기</a>
        </div>
    {{/companyBoardList}}
</div>

{{> layout/footer}}
