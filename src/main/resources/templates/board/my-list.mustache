{{> layout/header}}

<div class="container p-5">
    <!-- 상단 버튼 -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📋 내 채용공고 목록</h2>
        <a href="/board/save-form" class="btn btn-primary">✏️ 공고 등록</a>
    </div>

    <!-- 공고 리스트 -->
    {{#companyBoardList}}
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">{{title}}</h5>
                <p class="card-text text-muted">
                    기업명 : {{company.businessName}} &nbsp;|&nbsp; {{time}}
                </p>
                <div class="mb-3">
                    <!-- board.boardSkills 리스트를 반복 -->
                    {{#boardSkills}}
                        <!-- 반복문 안에서는 현재 요소(BoardSkill)의 skill 필드에 바로 접근 -->
                        <span class="badge bg-secondary me-1">{{skill.name}}</span>
                    {{/boardSkills}}
                </div>

                <div class="d-flex gap-2">
                    <a href="/board/{{id}}" class="btn btn-sm btn-outline-primary">상세보기</a>
                    <a href="/board/{{id}}/update-form" class="btn btn-sm btn-outline-secondary">수정</a>
                    <form action="/board/{{id}}/delete" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('정말 삭제하시겠습니까?')">삭제</button>
                    </form>
                </div>
            </div>
        </div>
    {{/companyBoardList}}

    <!-- 공고가 없는 경우 -->
    {{^companyBoardList}}
        <div class="text-center text-muted mt-5">
            <p>등록된 채용공고가 없습니다.</p>
            <a href="/board/save-form" class="btn btn-outline-primary">+ 첫 공고 등록하기</a>
        </div>
    {{/companyBoardList}}
</div>

{{> layout/footer}}
