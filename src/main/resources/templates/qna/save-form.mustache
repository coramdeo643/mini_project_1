{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header"><b>글쓰기 화면입니다</b></div>
        <div class="card-body">

            <form action="/qna/save" method="post">

                <div class="mb-3">
                </div>
                <div class="mb-3">
                    <input type="text" class="form-control" placeholder="Enter title" name="title"
                           id="myInput" maxlength="40" oninput="updateCounter()">
                    <div id="counter" style="text-align: right; font-size: 13px;">0 / 40</div>
                </div>
                <div class="mb-3">
                    <textarea class="form-control" rows="5" placeholder="Enter content" name="content"></textarea>
                </div>
                <button class="btn btn-primary form-control">글쓰기완료</button>
            </form>
        </div>
    </div>
</div>

{{> layout/footer}}