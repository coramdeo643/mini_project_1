{{> layout/header}}
<!--내가 구독한 구직자의 이력서 목록-->

<!-- Modal -->
<div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
     aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="staticBackdropLabel">관심기업 목록</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                {{> user-sub/company-sub-list}}
            </div>
        </div>
    </div>
</div>

<div class="container p-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📋 관심구직자 이력서 목록</h2>
        <!-- Button trigger modal -->
        <button type="button" class="btn btn-primary d-flex justify-content-end" data-bs-toggle="modal"
                data-bs-target="#staticBackdrop">
            🏢 전체 관심구직자 보기
        </button>
    </div>

    <div class="row">
        {{#companySubPostList}}
            <div class="col-md-4 mb-4" style="padding-left: 0.5rem; padding-right: 0.5rem;">
                <a href="/board/{{id}}" class="btn" style="display: block; width: 100%; text-decoration: none;">
                    <div class="card p-3 text-center" style="width: 100%;">
                        <div style="height: 100px; display: flex; justify-content: center; align-items: center; ">
                            <img src="/images/USER.jpg" alt="이력서 이미지"
                                 style="width: 100px; height: 100px; object-fit: cover; border-radius: 50%; background-color: #fff;">
                        </div>
                        <div class="card-body">
                            <h5 class="card-title">{{title}}</h5>
                            <p class="card-text">작성자 : {{user.personalName}}&nbsp|&nbsp{{time}}</p>
                            <div class="mb-3">
                                {{#pPostSkills}}
                                    <span class="badge text-primary-emphasis bg-primary-subtle border border-primary-subtle rounded-3 me-1">
                                        {{skill.name}}
                                    </span>
                                {{/pPostSkills}}
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        {{/companySubPostList}}
    </div>
</div>

{{> layout/footer}}