
{{#company}}
    <div class="card shadow-sm rounded" style="max-width: 360px; margin-left: auto;">
        <div class="card-body text-center py-3 px-3">
            <h6 class="card-title mb-2 fw-semibold">회사에 평점을 남겨보세요!</h6>

            <form action="/rating" method="post">
                <input type="hidden" name="companyId" value="{{id}}">
                <input type="hidden" name="score" id="scoreInput" value="0">

                <div id="stars" class="d-flex justify-content-center mb-2" style="font-size: 1.2rem;">
                    <span class="star mx-1" data-value="1">★</span>
                    <span class="star mx-1" data-value="2">★</span>
                    <span class="star mx-1" data-value="3">★</span>
                    <span class="star mx-1" data-value="4">★</span>
                    <span class="star mx-1" data-value="5">★</span>
                </div>

                <button type="submit" class="btn btn-success btn-sm">평점 등록</button>
            </form>
        </div>
    </div>
{{/company}}

<script>
    const stars = document.querySelectorAll('.star');
    const scoreInput = document.getElementById('scoreInput');

    stars.forEach((star, index) => {
      star.addEventListener('click', () => {
        const rating = star.dataset.value;
        scoreInput.value = rating;

        // 색 초기화
        stars.forEach(s => s.style.color = '#ccc');

        // 클릭한 별까지 골드 색상 적용
        for (let i = 0; i < rating; i++) {
          stars[i].style.color = 'gold';
        }
      });

      // 마우스 올렸을 때 효과 (선택은 아님)
      star.addEventListener('mouseover', () => {
        stars.forEach(s => s.style.color = '#ccc');
        for (let i = 0; i < star.dataset.value; i++) {
          stars[i].style.color = '#ffd700';
        }
      });

      // 마우스 빠졌을 때 원래 상태로 복구
      star.addEventListener('mouseout', () => {
        const current = scoreInput.value;
        stars.forEach(s => s.style.color = '#ccc');
        for (let i = 0; i < current; i++) {
          stars[i].style.color = 'gold';
        }
      });
    });
</script>
