{{> layout/header}}

<div class="container p-5">
    <!-- 기업 회원 로그인 폼 -->
    <div id="company-login" class="card">
        <div class="card-header text-center"><b>🏢 기업 회원 로그인</b></div>
        <div class="card-body">
            <form action="/company/login" method="post" enctype="application/x-www-form-urlencoded">
                <div class="mb-3">
                    <input type="text" class="form-control" placeholder="Enter company ID" name="username" value="samsung_hr">
                </div>
                <div class="mb-3">
                    <input type="password" class="form-control" placeholder="Enter password" name="password" value="pass1234">
                </div>
                <button type="submit" class="btn btn-success form-control">로그인</button>
            </form>
        </div>
    </div>
</div>

{{> layout/footer}}
